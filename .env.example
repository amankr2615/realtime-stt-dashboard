# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Defaults to SQLite locally, override with PostgreSQL in production)
DATABASE_URL=sqlite:///./transcriptions.db
# For PostgreSQL on Render:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Whisper STT Engine Configuration
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_DEVICE=cpu

# Audio Pipeline Configuration
SAMPLE_RATE=16000
CHANNELS=1
BATCH_DURATION_MS=100
INFERENCE_INTERVAL_SEC=1.0
MAX_BUFFER_SECONDS=5.0
AGREEMENT_COUNT=2
